# Copy to .env for local development. Never commit .env or put server secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
EXPO_PUBLIC_OPENWEATHER_API_KEY=your-openweather-key

# Clerk Authentication (handles login, sign-up, and password reset emails natively)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Cloudflare R2 Public Bucket URL (offloads static route polylines, GeoJSON, landmarks & APK download)
EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-your-r2-bucket.r2.dev
EXPO_PUBLIC_APK_DOWNLOAD_URL=https://pub-your-r2-bucket.r2.dev/releases/ejeephero-latest.apk
EXPO_PUBLIC_PWA_URL=https://ejeephero.pages.dev

# Server-side only. This key is currently not read by the mobile app.
DEEPSEEK_API_KEY=

# Set these in Supabase Edge Function secrets, never EXPO_PUBLIC_*.
# emergency-dispatch validates the signed-in Supabase or Clerk session itself.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:8081,https://your-app.example

# Retained for integrations that use Vite; the Expo app does not read this value.
VITE_API_URL=https://generativelanguage.googleapis.com/v1/models/gemini-1.5-pro:generateContent
