{
  "expo": {
    "name": "EjeepHero",
    "slug": "ejeephero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EjeepHero needs your location to track your ride and show your position on the map.",
        "NSLocationAlwaysUsageDescription": "EjeepHero needs your location to provide accurate ETAs and proximity alerts even when the app is in the background.",
        "NSMotionUsageDescription": "EjeepHero needs accelerometer access to detect potential anomalies or crashes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.mrsltycrml.ejeephero"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4E79",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.mrsltycrml.ejeephero"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EjeepHero to use your location."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow EjeepHero to access your contacts to set emergency speed dials."
        }
      ],
      "expo-sensors",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "5b2ac721-6a0d-4fc2-b767-44635d065cd7"
      }
    }
  }
}
