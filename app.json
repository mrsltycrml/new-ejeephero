{
  "expo": {
    "name": "EjeepHero",
    "slug": "ejeephero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ejeephero.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EjeepHero needs your location to track your ride and show your position on the map.",
        "NSMotionUsageDescription": "EjeepHero needs accelerometer access to detect potential anomalies or crashes."
      }
    },
    "android": {
      "package": "com.ejeephero.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1F4E79",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EjeepHero to show your location and share an active e-jeep shift."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C41E3A",
          "defaultChannel": "general"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow EjeepHero to access your contacts to set emergency speed dials."
        }
      ],
      "expo-sensors",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
